            android:label="@string/w_label_burn"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/burn_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TrafficWidgetProvider"
            android:label="@string/w_label_traffic"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/traffic_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ModelsWidgetProvider"
            android:label="@string/w_label_models"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/models_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.KeysWidgetProvider"
            android:label="@string/w_label_keys"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/keys_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SpeedWidgetProvider"
            android:label="@string/w_label_speed"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/speed_widget_info" />
        </receiver>

    </application>

</manifest>