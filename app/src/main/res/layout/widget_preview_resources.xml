<?xml version="1.0" encoding="utf-8"?>
<!-- Превью для списка виджетов: без выдуманных чисел, только назначение. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_hero"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ресурсы провайдеров"
        android:textSize="12sp"
        android:textColor="@color/w_on_var"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Квоты и балансы"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/w_on"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="остаток, давление и сброс"
        android:textSize="11sp"
        android:textColor="@color/w_on_var"
        android:maxLines="1" />
</LinearLayout>
