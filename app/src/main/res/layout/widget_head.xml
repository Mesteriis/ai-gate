<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка-вывод: надстрочник и время сверху, крупное значение, подстрочник.
  Та же анатомия, что у ChartCard в приложении (ui/design/Dashboards.kt).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/w_eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/w_on_var"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:textColor="@color/w_on_var"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_read"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/w_on"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/w_on_var"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
