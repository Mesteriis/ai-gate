<?xml version="1.0" encoding="utf-8"?>
<!-- Чип-вердикт и пояснение справа: тот же чип, что StatusChip в приложении. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:layout_marginTop="6dp">

    <TextView
        android:id="@+id/w_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip_neu"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textSize="12sp"
        android:textColor="@color/w_on_neu_c"
        android:maxLines="1" />

    <TextView
        android:id="@+id/w_chip_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:textSize="11sp"
        android:textColor="@color/w_on_var"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
