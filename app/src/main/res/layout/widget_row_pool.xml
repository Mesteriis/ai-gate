<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка пула ресурсов: знак провайдера, название, остаток и бар давления.
  Заливка бара — израсходованное, подпись всегда про остаток (инвариант приложения,
  ui/design/QuotaIndicators.kt).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/w_pool_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/w_pool_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/w_on"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_pool_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!--
      Два бара на выбор. На Android 12+ берётся ProgressBar: он тонируется
      цветом давления и ничего не весит, поэтому годится для прокручиваемого
      списка. На более старых системах тонирования нет — там показывается растр.
    -->
    <ProgressBar
        android:id="@+id/w_pool_bar_view"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:minHeight="8dp"
        android:maxHeight="8dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_bar"
        android:indeterminate="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/w_pool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/w_pool_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:textColor="@color/w_on_var"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
