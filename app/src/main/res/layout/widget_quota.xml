<?xml version="1.0" encoding="utf-8"?>
<!--
    Локальный виджет квот «ИИ Врата». Только простые Android-вью (без MaterialTheme):
    морозный фон #EDF3FC и тёмный текст #12233A. Рендерится из локального снимка,
    сеть не используется.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#EDF3FC">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ИИ Врата — квоты"
        android:textColor="#12233A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#12233A"
        android:textSize="12sp"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#12233A"
        android:textSize="12sp"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/widget_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#12233A"
        android:textSize="12sp"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingTop="2dp" />

</LinearLayout>
