<?xml version="1.0" encoding="utf-8"?>
<!--
  Общая оболочка всех виджетов комплекта. Содержимое собирается программно
  (RemoteViews.addView в w_rows), поэтому отдельного layout-файла на каждый
  виджет и на каждый размер не нужно.

  Два способа показать строки. Короткие наборы кладутся прямо в w_rows. Длинные
  (пулы, модели, ключи, вызовы) уходят в w_list — прокручиваемый ListView,
  который занимает всю свободную высоту; тогда в w_rows остаётся только
  строка-вывод. Список наполняется через setRemoteAdapter и работает с Android 12,
  на более старых системах строки просто обрезаются по высоте.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:background="@android:color/transparent"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/w_on_var"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
