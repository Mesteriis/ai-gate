<?xml version="1.0" encoding="utf-8"?>
<!--
  Оболочка виджета: радиус 24dp — имитация системного клипа Android 12+,
  внутренние карточки и бары остаются на фирменных 16dp. Тени нет: цветная тень
  на обоях читается грязью, вместо неё рамка в один пиксель.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <solid android:color="@color/w_surface" />
    <stroke android:width="1dp" android:color="@color/w_border" />
</shape>
