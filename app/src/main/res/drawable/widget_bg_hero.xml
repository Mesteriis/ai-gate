<?xml version="1.0" encoding="utf-8"?>
<!-- Витрина комплекта: единственный виджет с фирменным градиентом «врат». -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:startColor="@color/w_hero_start"
        android:endColor="@color/w_hero_end"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/w_border" />
</shape>
