    <color name="w_succ">#FF23B26A</color>
    <color name="w_warn">#FFF0A020</color>
    <color name="w_err">#FFE5484D</color>
    <color name="w_unk">#FF94A3B8</color>
    <color name="w_p_normal">#FF2E6FE0</color>

    <!-- Контейнеры чипов -->
