<?xml version="1.0" encoding="utf-8"?>
<!--
  Палитра домашних виджетов «морозные врата», светлая тема.

  RemoteViews не видит Compose-темы (ui/theme/Theme.kt), поэтому токены дублируются
  здесь ресурсами — единственный способ дать виджету автоматическое переключение
  светлой и тёмной темы вслед за системой (values-night/widget_colors.xml).
  Значения обязаны совпадать с ui/theme/Color.kt и ui/design/Tokens.kt.
-->
<resources>
    <!-- Поверхности и рамка -->
    <color name="w_surface">#FFFFFFFF</color>
    <color name="w_surface_low">#FFF4F8FE</color>
    <color name="w_surface_high">#FFE4EDFA</color>
    <color name="w_border">#1A2E6FE0</color>
    <color name="w_outline">#FFDBE6F5</color>
    <color name="w_hero_start">#FFFFFFFF</color>
    <color name="w_hero_end">#FFE7F0FC</color>

    <!-- Текст -->
    <color name="w_on">#FF16233A</color>
    <color name="w_on_var">#FF4A5A70</color>
    <color name="w_on_prim">#FFFFFFFF</color>

    <!-- Акцент и семантика -->
